# Python worker environment template (copy to services/worker/.env)

# --- Extraction SLM ---
MODEL_PROVIDER=none          # openai | ollama | none (deterministic fallback)
MODEL_NAME=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_QA_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.0

# --- Embeddings ---
EMBEDDING_PROVIDER=hashing   # openai | ollama | hashing
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Storage ---
LANCE_DB_PATH=./data/lancedb
GRAPH_STORE_PATH=./data/graph/chronos.gpickle
GRAPH_EXPORT_PATH=./data/graph/exports
DOC_STATE_DIR=./data/state
UPLOAD_DIR=./data/uploads

# --- Queue ---
WORKER_MODE=sync             # sync | async
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- API ---
WORKER_API_HOST=0.0.0.0
WORKER_API_PORT=8100
WORKER_API_TOKEN=change-me-dev-token

# --- Ingestion tuning ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
INGEST_BATCH_SIZE=8
MAX_GRAPH_CONTEXT_EDGES=60