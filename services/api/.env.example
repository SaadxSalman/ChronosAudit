# TypeScript/Express API environment (copy to services/api/.env)

PORT=4000
HOST=0.0.0.0

# Where the Python worker bridge (FastAPI) is reachable
WORKER_BASE_URL=http://localhost:8100
WORKER_API_TOKEN=change-me-dev-token

# Local file system
DATA_DIR=./data
WEB_DIR=../../web

# Multipart upload limits (bytes)
MAX_UPLOAD_BYTES=52428800