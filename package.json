{
  "name": "chronosaudit",
  "version": "1.0.0",
  "private": true,
  "description": "ChronosAudit — Temporal Knowledge-Graph RAG for live financial and regulatory auditing",
  "license": "MIT",
  "workspaces": [],
  "scripts": {
    "setup": "npm run setup:api && npm run setup:worker",
    "setup:api": "cd services/api && npm install",
    "setup:worker": "python -m pip install -r services/worker/requirements.txt",
    "build:api": "cd services/api && npm run build",
    "typecheck": "cd services/api && npm run typecheck",
    "test:api": "cd services/api && npm test",
    "test:worker": "cd services/worker && python -m pytest tests -v",
    "test:e2e": "python scripts/e2e_smoke.py",
    "test": "npm run test:worker && npm run test:api && npm run test:e2e",
    "dev:redis": "docker run --rm -p 6379:6379 --name chronos-redis redis:7-alpine",
    "dev:worker": "cd services/worker && uvicorn chronos.api:app --host 0.0.0.0 --port 8100 --reload",
    "dev:celery": "cd services/worker && celery -A chronos.celery_app worker -l info",
    "dev:api": "cd services/api && npm run dev",
    "dev:web": "npm run dev:api",
    "seed": "python scripts/seed_demo.py",
    "pdfs": "python scripts/make_sample_pdfs.py",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=18.17.0",
    "python": ">=3.10"
  }
}