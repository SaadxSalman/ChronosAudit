# ============================================================================
# ChronosAudit — root environment template
# Copy to `.env` and adjust. All variables are optional for a *fully offline*
# demo: without any API keys the system falls back to deterministic
# heuristics for extraction and embeddings.
# ============================================================================

# ---------------------------------------------------------------------------
# LLM / Slot machine ("SLM") used for extraction and answer synthesis
# ---------------------------------------------------------------------------
# One of: openai | ollama | none
MODEL_PROVIDER=ollama
# Name of the model to use for extraction and Q&A.
MODEL_NAME=llama3.2
# Only used when MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_QA_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Only used when MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
# openai -> text-embedding-3-small (1536 dims) | ollama -> nomic-embed-text (768) | hashing -> 512 dims
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
LANCE_DB_PATH=./data/lancedb
GRAPH_STORE_PATH=./data/graph/chronos.gpickle
GRAPH_EXPORT_PATH=./data/graph/exports
DOC_STATE_DIR=./data/state
UPLOAD_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Queue / orchestration
# ---------------------------------------------------------------------------
# async -> Celery + Redis (recommended for production)
# sync  -> run ingestion in-process inside the worker API (simplest dev mode)
WORKER_MODE=sync
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Services / auth
# ---------------------------------------------------------------------------
WORKER_API_HOST=0.0.0.0
WORKER_API_PORT=8100
WORKER_API_TOKEN=change-me-dev-token

EXPRESS_PORT=4000
EXPRESS_HOST=0.0.0.0
# URL the Express API uses to reach the Python worker bridge
WORKER_BASE_URL=http://localhost:8100

# Ingestion tuning
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
INGEST_BATCH_SIZE=8
MAX_GRAPH_CONTEXT_EDGES=60